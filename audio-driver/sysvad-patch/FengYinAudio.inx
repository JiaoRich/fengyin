[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/04/2026,1.1.0.0
CatalogFile = FengYinAudio.cat
PnpLockDown = 1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
tabletaudiosample.sys = 1

[Manufacturer]
%MfgName% = FengYin,NTamd64.10.0...16299

[FengYin.NTamd64.10.0...16299]
%FengYin.DeviceDesc% = FengYinAudio, Root\FengYinAudioEngine

[DestinationDirs]
FengYin.CopyList = 13

[FengYin.CopyList]
tabletaudiosample.sys

[FengYin.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,tabletaudiosample.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%FengYin.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%FengYin.DeviceDesc%

[FengYin.I.WaveSpeaker]
AddReg = FengYin.I.WaveSpeaker.AddReg

[FengYin.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FengYin.SpeakerName%

[FengYin.I.TopologySpeaker]
AddReg = FengYin.I.TopologySpeaker.AddReg

[FengYin.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FengYin.SpeakerName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[FengYinAudio.NT]
Include = ks.inf, wdmaudio.inf
Needs = KS.Registration, WDMAUDIO.Registration
CopyFiles = FengYin.CopyList
AddReg = FengYin.AddReg

[FengYinAudio.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, FengYin.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, FengYin.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, FengYin.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, FengYin.I.TopologySpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, FengYin.I.TopologySpeaker

[FengYinAudio.NT.Services]
AddService = FengYinAudio,0x00000002,FengYinAudio.Service

[FengYinAudio.Service]
DisplayName = %FengYin.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\tabletaudiosample.sys

[FengYinAudio.NT.HW]
AddReg = FengYinAudio.Hardware

[FengYinAudio.Hardware]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[FengYinAudio.NT.Wdf]
KmdfService = FengYinAudio,FengYinAudio.Wdf

[FengYinAudio.Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName = "FengYin"
MfgName = "FengYin"
DiskName = "FengYin Audio Driver"
FengYin.DeviceDesc = "风吟共享扬声器"
FengYin.ServiceDesc = "FengYin Shared Audio Driver"
FengYin.SpeakerName = "风吟共享扬声器"

KSNAME_WaveSpeaker = "WaveSpeaker"
KSNAME_TopologySpeaker = "TopologySpeaker"
Proxy.CLSID = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
